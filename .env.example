# Copier ce fichier en .env puis adapter.

# Adresse et port d'écoute.
# - Derrière un reverse proxy HTTPS sur la même machine : BOURSE_HOST=127.0.0.1
# - Accès direct depuis le réseau local : BOURSE_HOST=0.0.0.0
BOURSE_HOST=0.0.0.0
BOURSE_PORT=9699

# Base SQLite (utilisateurs, sessions, favoris).
# BOURSE_DB=data/bourse.db

# Cookie de session "Secure" : auto (si HTTPS), true ou false.
BOURSE_COOKIE_SECURE=auto
BOURSE_SESSION_DAYS=30

# IP du reverse proxy autorisé à transmettre X-Forwarded-For / X-Forwarded-Proto.
BOURSE_FORWARDED_ALLOW_IPS=127.0.0.1

# HTTPS direct, sans reverse proxy (optionnel).
# BOURSE_SSL_CERTFILE=/chemin/fullchain.pem
# BOURSE_SSL_KEYFILE=/chemin/privkey.pem

# Anti force brute : nombre d'échecs tolérés par fenêtre (secondes), par IP et par utilisateur.
BOURSE_LOGIN_MAX_FAILURES=5
BOURSE_LOGIN_WINDOW_SECONDS=900

BOURSE_LOG_LEVEL=info
# BOURSE_DEBUG=true   # rechargement automatique du code (développement)
